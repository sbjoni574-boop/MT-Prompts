{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mt-prompts",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mt-prompts-db",
      "database_id": "local-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "mt-prompts-r2"
    }
  ]
}
